{
  "version": 2,
  "builds": [
    {
      "src": "frontend/**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/styles/(.*)", "dest": "/frontend/styles/$1" },
    { "src": "/modules/(.*)", "dest": "/frontend/modules/$1" },
    { "src": "/api.js", "dest": "/frontend/api.js" },
    { "src": "/(.*)", "dest": "/frontend/$1" }
  ]
}
